// Marked: a star beside any line of a note, and one list of every line
// marked (docs/modern/marking.md).  Compiled into newton (HostMarksSource.cpp,
// made by src/cmake/EmbedText.cmake) and evaluated at boot by
// HostInstallMarks (host/HostMarks.cpp); the frame is kept in the global
// HostMarks:host.
//
// DEVIATION (host addition, host/Features.h's kFeatureMarking - the Host
// panel's "Marks", NEWTON_MARKING): the ROM marks nothing finer than a
// whole note filed in a folder.  With marking on:
//
// - the pop-up a tap on the caret brings up has a row "* Mark" under the
//   space bar (views/CaretWriting.cpp): it marks the paragraphs that have
//   something selected in them, or with nothing selected the one with the
//   caret - or, when every one of them is marked already, takes their
//   marks off.  (ToggleMarks, below.)
// - the mark is kept in the paragraph itself, a slot `marked` of its data
//   frame (the form the note's entry holds in its data array) - the time
//   it was marked, in minutes - so it goes wherever the note goes (saved,
//   beamed, synced), a MessagePad opens the note as it is, and no list
//   kept beside the notes can fall out of step with them.  The note's view
//   draws a small star in the margin beside a marked paragraph
//   (TEditView::DrawMarks).
// - the Marked application in Extras lists every marked paragraph of
//   every note, newest first: its text (ink words by their readings,
//   ink/InkReading.h), and the note's first line and date.  A tap on a
//   row opens the note in the Notepad (its ShowFoundItem, as Find does); a
//   tap on a row's star takes the mark off.
//
// A departure from marking.md, which kept the marks in a soup of their
// own: the list is made by reading the notes when Marked opens.  That is
// slower with thousands of notes, but cannot disagree with them; a soup
// can be added as an index later without changing where a mark lives.

{
	appSymbol: '|Marked:host|,
	notesSoup: "Notes",

	app: {
		viewClass: 74,							// clView
		viewFlags: 5,							// vVisible, vApplication
		viewFormat: 273,						// white, a one-pixel black frame
		viewBounds: {left: 0, top: 0, right: 240, bottom: 320},
		declareSelf: 'base,
		viewFont: 10240,
		appSymbol: '|Marked:host|,
		title: "Marked",
		ReOrientToScreen: func() :Relayout(),

		kFont: 10240,							// the system font, 10 point
		kBold: 1058816,							// bold
		kSmall: 9216,							// 9 point

		marks: nil,								// the marked paragraphs, newest first (Collect)
		scroll: 0,								// rows scrolled past
		listView: nil,

		viewSetupFormScript: func()
		begin
			local p := GetAppParams();
			viewBounds := RelBounds(p.appAreaLeft, p.appAreaTop, p.appAreaWidth, p.appAreaHeight);
		end,

		viewSetupDoneScript: func()
		begin
			foreach v in :ChildViewFrames() do
				if v.role then
					self.(v.role) := v;
			:Reload();
			:Layout();
		end,

		viewQuitScript: func()
		begin
			listView := nil;
			marks := nil;
		end,

		Relayout: func()
		begin
			local p := GetAppParams();
			SetValue(self, 'viewBounds, RelBounds(p.appAreaLeft, p.appAreaTop, p.appAreaWidth, p.appAreaHeight));
			:Layout();
		end,

		Layout: func()
		begin
			local box := :LocalBox();
			SetValue(listView, 'viewBounds, RelBounds(0, 0, box.right, box.bottom));
		end,

		Reload: func()
		begin
			marks := GetGlobalVar('|HostMarks:host|):Collect();
			if scroll >= Length(marks) then scroll := 0;
			if listView then listView:Dirty();
		end,

		viewChildren: [
			// the list: a title line, then a row a mark
			{
				viewClass: 74, viewFlags: 513, viewFormat: 0, role: 'listView,
				viewBounds: {left: 0, top: 0, right: 240, bottom: 300},
				HeaderHeight: func() FontHeight(:Parent().kBold) + 10,
				RowHeight: func() FontHeight(:Parent().kBold) + FontHeight(:Parent().kSmall) + 12,
				viewDrawScript: func()
				begin
					local base := :Parent();
					local b := :LocalBox();
					local w := b.right;
					local hh := :HeaderHeight();
					local count := if base.marks then Length(base.marks) else 0;
					:DrawShape(MakeText("Marked", 8, 4, w div 2, 4 + FontHeight(base.kBold)), {font: base.kBold});
					local n := NumberStr(count) & (if count = 1 then " line" else " lines");
					local nw := StrFontWidth(n, base.kSmall);
					local cw := StrFontWidth("Close", base.kBold);
					:DrawShape(MakeText(n, w - nw - cw - 24, 6, w - cw - 16, 6 + FontHeight(base.kSmall)), {font: base.kSmall});
					:DrawShape(MakeRoundRect(w - cw - 12, 2, w - 3, hh - 4, 4), {penSize: 1});
					:DrawShape(MakeText("Close", w - cw - 7, 4, w - 4, 4 + FontHeight(base.kBold)), {font: base.kBold});
					:DrawShape(MakeLine(0, hh - 1, w, hh - 1), {penSize: 1});
					if count = 0 then begin
						:DrawShape(MakeText("Nothing is marked.", 12, hh + 12, w - 12, hh + 30), {font: base.kFont});
						:DrawShape(MakeText("Tap the caret in a note and choose Mark.", 12, hh + 16 + FontHeight(base.kFont), w - 12, hh + 60), {font: base.kSmall});
						return;
					end;
					local rowH := :RowHeight();
					local y := hh;
					local i := base.scroll;
					while i < count and y < b.bottom do begin
						local m := base.marks[i];
						base:DrawStar(self, 6, y + 6);
						:DrawShape(MakeText(StyledStrTruncate(m.text, w - 30, base.kBold), 22, y + 4, w - 6, y + 4 + FontHeight(base.kBold)),
							{font: base.kBold});
						local under := StyledStrTruncate(m.title, w - 120, base.kSmall);
						:DrawShape(MakeText(under & "  " & base:WhenText(m.time), 22, y + 8 + FontHeight(base.kBold), w - 6, y + rowH - 2),
							{font: base.kSmall});
						:DrawShape(MakeLine(4, y + rowH - 1, w - 4, y + rowH - 1), {penSize: 1, penPattern: 3});
						y := y + rowH;
						i := i + 1;
					end;
				end,
				viewClickScript: func(unit)
				begin
					local base := :Parent();
					local box := :GlobalBox();
					local y := GetPoint(5, unit) - box.top - :HeaderHeight();
					local x := GetPoint(4, unit) - box.left;
					if y < 0 then begin
						// the header: Close at its right; elsewhere, a page back
						if x > box.right - box.left - StrFontWidth("Close", base.kBold) - 14 then base:Close()
						else base:ScrollBy(-1);
						return true;
					end;
					if not base.marks then return true;
					// below the last row: a page on
					if base.scroll + y div :RowHeight() >= Length(base.marks) then begin
						base:ScrollBy(1);
						return true;
					end;
					local i := base.scroll + y div :RowHeight();
					if i < Length(base.marks) then begin
						local m := base.marks[i];
						if x < 20 then
							GetGlobalVar('|HostMarks:host|):Unmark(m)
						else
							GetGlobalVar('|HostMarks:host|):OpenMark(m);
					end;
					true;
				end
			}
		],

		ScrollBy: func(pages)
		begin
			if not marks then return;
			local rows := Max(1, ((listView:LocalBox()).bottom - listView:HeaderHeight()) div listView:RowHeight());
			local was := scroll;
			scroll := Max(0, Min(scroll + pages * rows, Length(marks) - 1));
			if scroll = was and pages > 0 then scroll := 0;		// (past the end: back to the top)
			listView:Dirty();
		end,

		// the star, 7 pixels across, its top left at x, y of the view
		DrawStar: func(view, x, y)
		begin
			local rows := ["...#...", "...#...", "#######", ".#####.", "..###..", ".##.##.", "#.....#"];
			foreach r, row in rows do
				for c := 0 to 6 do
					if row[c] = $# then
						view:DrawShape(MakeRect(x + c, y + r, x + c + 1, y + r + 1), {penPattern: 0, fillPattern: 5});
		end,

		// when a mark was made, as the date (and the time, today)
		WhenText: func(minutes)
		begin
			if not IsInteger(minutes) then return "";
			if minutes div 1440 = Time() div 1440 then begin
				// "2:38 PM", as Messages writes it (HostMessages.ns's TimeText)
				local m := minutes mod 1440;
				local hour := m div 60;
				local minute := m mod 60;
				local suffix := if hour >= 12 then " PM" else " AM";
				hour := hour mod 12;
				if hour = 0 then hour := 12;
				NumberStr(hour) & ":" & (if minute < 10 then "0" else "") & NumberStr(minute) & suffix;
			end else
				ShortDate(minutes);
		end
	},

	// Every marked paragraph of every note: {entry, index, time, text,
	// title}, newest first.
	Collect: func()
	begin
		local out := [];
		local soup := GetUnionSoupAlways(notesSoup);
		if not soup then return out;
		local cursor := soup:Query({});
		local e := cursor:Entry();
		while e do begin
			if IsArray(e.data) then
				foreach i, form in e.data do
					if IsFrame(form) and form.marked then
						AddArraySlot(out, {entry: e, index: i, time: form.marked, text: :TextOf(form),
							title: :TitleOf(e)});
			e := cursor:Next();
		end;
		Sort(out, '|>|, 'time);
		out;
	end,

	// a note's first line of text, for the list
	TitleOf: func(entry)
	begin
		if IsArray(entry.data) then
			foreach form in entry.data do
				if IsFrame(form) and IsString(form.text) then begin
					local t := :TextOf(form);
					if StrLen(t) > 0 then return t;
				end;
		"Untitled";
	end,

	// A paragraph's text, each ink word as its reading (or "~" when it
	// has none yet), and line breaks as spaces.
	TextOf: func(form)
	begin
		local t := form.text;
		if not IsString(t) then return "";
		local styles := form.styles;
		local out := "";
		if IsArray(styles) and StrPos(t, Stringer([Chr(0xF701)]), 0) then begin
			local offset := 0;
			for i := 0 to Length(styles) - 2 by 2 do begin
				local n := styles[i];
				if n = 1 and offset < StrLen(t) and Ord(t[offset]) = 0xF701 then begin
					local r := InkReading(styles[i + 1]);
					out := out & (if r and StrLen(r) > 0 then r else "~");
				end else
					out := out & SubStr(t, offset, Min(n, StrLen(t) - offset));
				offset := offset + n;
			end;
		end else
			out := Clone(t);
		for i := 0 to StrLen(out) - 1 do
			if out[i] = $\n then out[i] := $ ;
		out;
	end,

	// The entry a paragraph view's note is: the first view up from it
	// whose target is a soup entry.
	EntryOf: func(view)
	begin
		local v := view;
		local depth := 0;
		while v and depth < 10 do begin
			if v.target and IsSoupEntry(v.target) then return v.target;
			v := v._parent;
			depth := depth + 1;
		end;
		nil;
	end,

	// The paragraph views given marked - or, when all of them are marked
	// already, unmarked.  ==> true for marked, nil for unmarked.
	ToggleMarks: func(paras)
	begin
		local forms := [];
		foreach p in paras do
			if IsFrame(p) and IsFrame(p._proto) and not IsReadOnly(p._proto) then
				AddArraySlot(forms, p._proto);
		if Length(forms) = 0 then return nil;
		local all := true;
		foreach f in forms do
			if not f.marked then all := nil;
		local now := Time();
		foreach f in forms do
			if all then RemoveSlot(f, 'marked)
			else if not f.marked then f.marked := now;
		local saved := [];
		foreach p in paras do begin
			local e := :EntryOf(p);
			if e and not SetContains(saved, e) then begin
				AddArraySlot(saved, e);
				EntryChangeXmit(e, nil);
			end;
			if p._parent then p._parent:Dirty();
		end;
		:Refresh();
		not all;
	end,

	// one mark of the list taken off
	Unmark: func(mark)
	begin
		local data := mark.entry.data;
		if IsArray(data) and mark.index < Length(data) and IsFrame(data[mark.index]) then begin
			RemoveSlot(data[mark.index], 'marked);
			EntryChangeXmit(mark.entry, nil);
		end;
		:Refresh();
	end,

	// the note of a mark opened in the Notepad, as Find opens one
	OpenMark: func(mark)
	begin
		local notepad := GetRoot().paperroll;
		if not notepad then return nil;
		notepad:Open();
		notepad:ShowFoundItem(mark.entry, nil);
		true;
	end,

	// the list drawn again, if it is open
	Refresh: func()
	begin
		local base := GetRoot().(appSymbol);
		if base and base.viewCObject then base:Reload();
	end,

	// a star for the Extras drawer
	MakeIcon: func()
	begin
		local bitmap := MakeBitmap(28, 26, nil);
		DrawIntoBitmap([MakePolygon([14, 1, 17, 10, 27, 10, 19, 16, 22, 25, 14, 20, 6, 25, 9, 16, 1, 10, 11, 10, 14, 1])],
			{penSize: 2, penPattern: 5, fillPattern: 0}, bitmap);
		bitmap;
	end,

	// the Extras entry, found (nil: none)
	IconEntry: func()
	begin
		local extras := GetUnionSoup(@307.name);
		if not extras then return nil;
		local cursor := Query(extras, {type: 'index});
		local e;
		while (e := cursor:Entry()) do begin
			if e.app = appSymbol then return e;
			cursor:Next();
		end;
		nil;
	end,

	// marking on: the application and its icon; off: the icon taken away
	Start: func()
	begin
		if not HostFeatureOn('marking) then
			return :Stop();
		if not GetRoot().(appSymbol) then
			GetRoot().(appSymbol) := BuildContext(app);
		if not :IconEntry() then begin
			local extras := GetUnionSoup(@307.name);
			if extras then
				extras:AddToDefaultStoreXmit({class: 'ROMFormEntry, text: "Marked", app: appSymbol,
					icon: :MakeIcon(), labels: nil, sequence: 31, _tagList: ['_icon, '_noBackup]}, nil);
		end;
	end,

	Stop: func()
	begin
		local e := :IconEntry();
		if e then EntryRemoveFromSoupXmit(e, nil);
		local base := GetRoot().(appSymbol);
		if base and base.viewCObject then base:Close();
	end
}
