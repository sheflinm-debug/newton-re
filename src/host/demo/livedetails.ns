// Live details (docs/modern/structure.md; views/LiveDetails.h,
// host/HostMarks.ns's DetailTapped).  With NEWTON_STRUCTURE=1: "ton" is
// written on the Notepad and read, and the paragraph's text made
// "www.newton.org": it is underlined with a dotted line, and a tap on it
// pops up Open and Copy; Open hands "http://www.newton.org" to the device
// (NEWTON_OPEN_URL=print: printed, not opened).  Then "555 123 4567": Call
// hands "tel:5551234567" on.  Without it a tap on the text puts the caret
// there (ctests host.NewtonLiveDetails and ...off).
//
//   NEWTON_STRUCTURE=1 NEWTON_OPEN_URL=print build/host/host/newton --display 320x480 //       --headless 120 --script src/host/demo/livedetails.ns
//
// Leaves build/livedetails.pgm (the address underlined, its pop-up up).

HostInclude("common.ns");			// waitFor, walkSetup

ldName := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

ldStroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

ldOval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// "ton", as keep-ink.ns writes it
ldBase := 200;
ldTon := [[66, ldBase - 24, 66, ldBase - 18, 66, ldBase - 12, 66, ldBase - 6, 66, ldBase],
          [60, ldBase - 14, 64, ldBase - 14, 68, ldBase - 14, 72, ldBase - 14],
          call ldOval with (82, ldBase - 7, 6, 7),
          [94, ldBase - 14, 94, ldBase - 7, 94, ldBase, 94, ldBase - 7,
           95, ldBase - 11, 97, ldBase - 13, 100, ldBase - 14, 103, ldBase - 13,
           104, ldBase - 10, 104, ldBase - 5, 104, ldBase]];

ldFindParagraph := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and	// clParagraphView (flags above it)
       IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call ldFindParagraph with (child, prefix);
    found;
  end;

// what the page holds, said so a test can match it: an ink word is the
// one character 0xF701
ldSay := func(para)
  begin
    local out := "";
    for i := 0 to StrLen(para.text) - 1 do
      out := out & (if Ord(para.text[i]) = 0xF701 then "<ink>" else SPrintObject(para.text[i]));
    out;
  end;

ldTap := func(x, y) begin PenDown(x, y); PenUp(); end;

// the pop-up, when it is up: the root's pild view
ldPopup := func()
  begin
    local found := nil;
    foreach child in GetRoot():ChildViewFrames() do
      if BAnd(child.viewClass, 0xFFFF) = 91 then found := child;	// clPildView
    found;
  end;

// the caret tapped, and once the pop-up is up `andThen` called with it
ldOpen := func(what, andThen)
  call waitFor with (what & ": the caret", func() GetCaretBox() and not call ldPopup with (), func() begin
      local c := GetCaretBox();
      call ldTap with ((c.left + c.right) div 2, (c.top + c.bottom) div 2);
      call waitFor with (what & ": the pop-up", ldPopup, func() call andThen with (call ldPopup with ()), 20);
    end, 20);

// a tap on the paragraph's first word, and once the pop-up is up `andThen`
// called with it (nil: none came)
ldTapText := func(para, what, andThen)
  begin
    local pb := para:GlobalBox();
    call ldTap with (pb.left + 12, (pb.top + pb.bottom) div 2);
    local asked := Ticks();
    call waitFor with (what, func() call ldPopup with () or Ticks() - asked > 120, func() call andThen with (call ldPopup with ()), 10);
  end;

call walkSetup with (ldName, func() begin
    foreach s in ldTon do call ldStroke with (s);
    IdleStrokes();
    call waitFor with ("details: the word read", func() call ldFindParagraph with (GetRoot(), "ton"), func() begin
        local para := call ldFindParagraph with (GetRoot(), "ton");
        SetValue(para, 'text, "www.newton.org");
        AddDelayedCall(func() call ldTapText with (para, "details: the address's pop-up", func(pop) begin
            if not pop then begin
                Print("details: a tap on the address, no pop-up");
                Print("details: done");
                return HostQuit();
              end;
            Print("details: a tap on the address, the pop-up has " & Length(pop.pickItems) & " items, the first " & pop.pickItems[0]);
            ScreenSnapshot("build/livedetails.pgm");
            local pbox := pop:GlobalBox();
            AddDelayedCall(func() call ldTap with ((pbox.left + pbox.right) div 2, pbox.top + 9), nil, 500);
            call waitFor with ("details: Open picked", func() not call ldPopup with (), func() begin
                SetValue(para, 'text, "555 123 4567");
                AddDelayedCall(func() call ldTapText with (para, "details: the number's pop-up", func(pop2) begin
                    if pop2 then begin
                        Print("details: a tap on the number, the first " & pop2.pickItems[0]);
                        local b2 := pop2:GlobalBox();
                        AddDelayedCall(func() call ldTap with ((b2.left + b2.right) div 2, b2.top + 9), nil, 500);
                      end;
                    call waitFor with ("details: Call picked", func() not call ldPopup with (), func() begin
                        AddDelayedCall(func() begin Print("details: done"); HostQuit(); end, nil, 500);
                      end, 20);
                  end), nil, 1000);
              end, 20);
          end), nil, 1000);
      end, 60);
  end);
