// Files (docs/modern/files.md; host/HostFiles.ns, host/HostFiles.cpp).
// With NEWTON_FILES=1 and NEWTON_FILES_ROOT a folder of the build's: the
// folder is made with its standard folders; a Markdown file is written into
// Documents (HostFilesWriteText); a path climbing out of the folder is
// refused; the Files application lists the root's folders, a tap opens
// Documents, a tap on the file makes a note of it - the heading in bold,
// the paragraphs split at the blank line - and opens it in the Notepad.
// Then files as entries: Shopping.md is an entry of the Files soup; a file
// written from outside becomes one, and the soup's watchers are told;
// Find, Everywhere, finds it by a word of its text; the entry renamed and
// moved by another application moves the file; removed, the file goes to
// the hidden trash, which is not in the soup.
// Without it there is no application (ctests host.NewtonFiles and ...off).
//
//   NEWTON_FILES=1 NEWTON_FILES_ROOT=build/files-demo build/host/host/newton //       --display 320x480 --headless 120 --script src/host/demo/files.ns
//
// Leaves build/files-list.pgm (Documents), build/files-note.pgm (the
// note made of the file) and build/files-find.pgm (Find's answer).

HostInclude("common.ns");			// waitFor, walkSetup
HostInclude("walkhelpers.ns");		// viewWithText, typeStr

fdName := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

fdTap := func(x, y) begin PenDown(x, y); PenUp(); end;

fdYesNo := func(x) if x then "true" else "nil";

// the note made of a file (nil: none yet)
fdNoteOf := func(path)
  begin
    local found := nil;
    local cursor := GetUnionSoup("Notes"):Query({});
    local e := cursor:Entry();
    while e do
      begin
        if e.fromFile and StrEqual(e.fromFile, path) then found := e;
        e := cursor:Next();
      end;
    found;
  end;

fdNote := func() call fdNoteOf with ("Documents/Shopping.md");

// the row of an item in the app's list, tapped
fdTapRow := func(app, name)
  begin
    local index := nil;
    foreach i, item in app.items do
      if not index and StrEqual(item.name, name) then index := i;
    local lb := app.listView:GlobalBox();
    call fdTap with (lb.left + 60, lb.top + app.listView:HeaderHeight() + (index - app.scroll) * app.listView:RowHeight() + 8);
  end;

// the Files soup's entry of a file (nil: none)
fdEntry := func(disk)
  begin
    local found := nil;
    local soup := GetUnionSoup("Files");
    if soup then
      begin
        local cursor := soup:Query({});
        local e := cursor:Entry();
        while e do
          begin
            if IsString(e.disk) and StrEqual(e.disk, disk) then found := e;
            e := cursor:Next();
          end;
      end;
    found;
  end;

fdChanges := [];			// the Files soup's notifications, as a watcher sees them

fdHasWhatThe := func()
  begin
    local seen := nil;
    foreach t in fdChanges do if t = 'whatThe then seen := true;
    seen;
  end;

// Files as entries: the soup, a file from outside, Find, a rename, the trash
fdEntries := func()
  begin
    RegSoupChange("Files", '|fdWatch:host|, func(s, a, t, d) AddArraySlot(fdChanges, t));
    call waitFor with ("files: the soup", func() call fdEntry with ("Documents/Shopping.md"), func() begin
        local e := call fdEntry with ("Documents/Shopping.md");
        Print("files: Shopping.md is an entry: " & e.kind & ", " & e.size & " bytes, in " & e.path);
        fdChanges := [];
        // a file come from elsewhere: only its words name the tester
        HostFilesWriteText("Downloads/Plan.txt", "Plan\n\nthe folder read by our tester\n");
        call waitFor with ("files: the new file", func() call fdEntry with ("Downloads/Plan.txt") and call fdHasWhatThe with (), func() begin
            Print("files: Plan.txt became an entry, the soup's watchers told (whatThe)");
            // Find, Everywhere, "tester" (as the walkthrough finds)
            call tapAt with (220, 460);
            call waitFor with ("files: the Find slip", func() call viewWithText with ("Look for"), func() begin
                call typeStr with ([17, 14, 1, 17, 14, 15]);			// "tester"
                call tapAt with (78, 380);							// Everywhere
                AddDelayedCall(func() begin
                    call tapAt with (274, 396);						// Find
                    call waitFor with ("files: Find", func() call viewWithText with ("found"), func() begin
                        local found := call viewWithText with ("found");
                        Print("files: Find says " & found.text);
                        call waitFor with ("files: the found file opened", func() call fdNoteOf with ("Downloads/Plan.txt"), func() begin
                        local base := GetRoot().|Files:host|;
                        Print("files: Find opened Plan.txt as a note, Files in front of it " & call fdYesNo with (base.viewCObject));
                        AddDelayedCall(func() begin
                            ScreenSnapshot("build/files-find.pgm");
                            if GetRoot().findDrawer and GetRoot().findDrawer.viewCObject then GetRoot().findDrawer:Close();
                            call fdRename with ();
                          end, nil, 1000);
                          end, 20);
                      end, 30);
                  end, nil, 500);
              end, 20);
          end, 20);
      end, 20);
  end;

// the entry renamed and moved by another application: the file follows;
// then removed: the file goes to the trash
fdRename := func()
  begin
    local e := call fdEntry with ("Downloads/Plan.txt");
    e.name := "Tester plan.txt";
    e.path := "Documents";
    EntryChangeXmit(e, '|fdTest:host|);
    call waitFor with ("files: the rename", func() HostFilesExists("Documents/Tester plan.txt") = 'file, func() begin
        Print("files: renamed on the Newton, on the disk Documents/Tester plan.txt " & call fdYesNo with (HostFilesExists("Documents/Tester plan.txt"))
          & ", Downloads/Plan.txt " & call fdYesNo with (HostFilesExists("Downloads/Plan.txt")));
        local moved := call fdEntry with ("Documents/Tester plan.txt");
        EntryRemoveFromSoupXmit(moved, '|fdTest:host|);
        call waitFor with ("files: the trash", func() HostFilesExists(".Trash/Tester plan.txt") = 'file
            and not HostFilesExists("Documents/Tester plan.txt"), func() begin
            // (and the trash is not in the soup)
            local files := GetGlobalVar('|HostFiles:host|);
            files:Sync();
            Print("files: removed on the Newton, in the trash " & call fdYesNo with (HostFilesExists(".Trash/Tester plan.txt"))
              & ", an entry " & call fdYesNo with (call fdEntry with (".Trash/Tester plan.txt") or call fdEntry with ("Documents/Tester plan.txt")));
            Print("files: done");
            HostQuit();
          end, 20);
      end, 20);
  end;

call walkSetup with (fdName, func() begin
    local on := HostFeatureOn('files);
    Print("files: HostFeatureOn " & call fdYesNo with (on) & ", the application " & call fdYesNo with (GetRoot().|Files:host|));
    if not on then
      begin
        Print("files: done");
        return HostQuit();
      end;
    HostFilesRoot();
    Print("files: written " & call fdYesNo with (HostFilesWriteText("Documents/Shopping.md",
      "# Shopping\n\nmilk and eggs\nbread\n\n- apples\n")));
    Print("files: ../ listed " & call fdYesNo with (HostFilesList("..")));
    local app := GetRoot().|Files:host|;
    app:Open();
    call waitFor with ("files: the root", func() app.viewCObject and app.items, func() begin
        local names := "";
        foreach i, item in app.items do names := names & (if i > 0 then ", " else "") & item.name;
        Print("files: the root holds " & names);
        AddDelayedCall(func() begin
            call fdTapRow with (app, "Documents");
            call waitFor with ("files: Documents", func() StrEqual(app.folder, "Documents") and Length(app.items) > 0, func() begin
                Print("files: Documents holds " & app.items[0].name & ", " & GetGlobalVar('|HostFiles:host|):KindOf(app.items[0].name));
                AddDelayedCall(func() begin
                    ScreenSnapshot("build/files-list.pgm");
                    call fdTapRow with (app, "Shopping.md");
                    call waitFor with ("files: the note", fdNote, func() begin
                        local note := call fdNote with ();
                        Print("files: the note has " & Length(note.data) & " paragraphs: " & note.data[0].text
                          & " (bold " & (if BAnd(note.data[0].viewFont, 1048576) <> 0 then "yes" else "no") & "), " & note.data[1].text);
                        AddDelayedCall(func() begin
                            ScreenSnapshot("build/files-note.pgm");
                            call fdEntries with ();
                          end, nil, 1000);
                      end, 20);
                  end, nil, 500);
              end, 20);
          end, nil, 500);
      end, 20);
  end);
