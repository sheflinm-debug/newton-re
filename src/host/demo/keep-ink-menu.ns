// The caret's pop-up with ink kept after recognition (docs/modern/
// ink-and-text.md; views/CaretWriting.h).  "ton" is written on the Notepad
// and read; a tap on the caret brings up the punctuation grid and the space
// bar, and with NEWTON_KEEP_INK=1 a strip of two cells under them: "Abc" and
// a scribble.  The scribble is tapped - nothing being selected, the whole
// note is shown as its writing - and then, the pop-up brought up again,
// "Abc", which shows it as text.  Without NEWTON_KEEP_INK the pop-up is the
// ROM's: two items (ctests host.NewtonKeepInkMenu and ...off).
//
//   NEWTON_KEEP_INK=1 build/host/host/newton --display 320x480 --headless 120 //       --script src/host/demo/keep-ink-menu.ns
//
// Leaves build/keep-ink-menu.pgm: the pop-up, the strip at its foot.

HostInclude("common.ns");			// waitFor, walkSetup

kmName := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

kmStroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

kmOval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// "ton", as keep-ink.ns writes it
kmBase := 200;
kmTon := [[66, kmBase - 24, 66, kmBase - 18, 66, kmBase - 12, 66, kmBase - 6, 66, kmBase],
          [60, kmBase - 14, 64, kmBase - 14, 68, kmBase - 14, 72, kmBase - 14],
          call kmOval with (82, kmBase - 7, 6, 7),
          [94, kmBase - 14, 94, kmBase - 7, 94, kmBase, 94, kmBase - 7,
           95, kmBase - 11, 97, kmBase - 13, 100, kmBase - 14, 103, kmBase - 13,
           104, kmBase - 10, 104, kmBase - 5, 104, kmBase]];

kmFindParagraph := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and	// clParagraphView (flags above it)
       IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call kmFindParagraph with (child, prefix);
    found;
  end;

// what the page holds, said so a test can match it: an ink word is the
// one character 0xF701
kmSay := func(para)
  begin
    local out := "";
    for i := 0 to StrLen(para.text) - 1 do
      out := out & (if Ord(para.text[i]) = 0xF701 then "<ink>" else SPrintObject(para.text[i]));
    out;
  end;

kmTap := func(x, y) begin PenDown(x, y); PenUp(); end;

// the pop-up, when it is up: the root's pick view
kmPopup := func()
  begin
    local found := nil;
    foreach child in GetRoot():ChildViewFrames() do
      if BAnd(child.viewClass, 0xFFFF) = 91 then found := child;	// clPickView
    found;
  end;

// the caret tapped, and once the pop-up is up `andThen` called with it
kmOpen := func(what, andThen)
  call waitFor with (what & ": the caret", func() GetCaretBox() and not call kmPopup with (), func() begin
      local c := GetCaretBox();
      call kmTap with ((c.left + c.right) div 2, (c.top + c.bottom) div 2);
      call waitFor with (what & ": the pop-up", kmPopup, func() call andThen with (call kmPopup with ()), 20);
    end, 20);

call walkSetup with (kmName, func() begin
    foreach s in kmTon do call kmStroke with (s);
    IdleStrokes();
    call waitFor with ("keep-ink-menu: the word read", func() call kmFindParagraph with (GetRoot(), "ton"), func() begin
        local para := call kmFindParagraph with (GetRoot(), "ton");
        call kmOpen with ("keep-ink-menu", func(pop) begin
            local items := Length(pop.pickItems);
            local box := pop:GlobalBox();
            Print("keep-ink-menu: KeepsInk " & (if KeepsInk() then "true" else "nil") & ", the pop-up has " & items & " items");
            AddDelayedCall(func() begin
                ScreenSnapshot("build/keep-ink-menu.pgm");
                if items < 3 then
                  begin
                    pop:Close();
                    Print("keep-ink-menu: done");
                    HostQuit();
                  end
                else
                  begin
                    // the scribble: the right-hand cell of the strip at the foot
                    call kmTap with (box.left + 33, box.bottom - 13);
                    call waitFor with ("keep-ink-menu: shown as writing", func() Ord(para.text[0]) = 0xF701, func() begin
                        Print("keep-ink-menu: scribble tapped: " & call kmSay with (para));
                        call kmOpen with ("keep-ink-menu again", func(pop2) begin
                            local box2 := pop2:GlobalBox();
                            call kmTap with (box2.left + 12, box2.bottom - 13);		// "Abc"
                            call waitFor with ("keep-ink-menu: shown as text", func() StrEqual(para.text, "ton"), func() begin
                                Print("keep-ink-menu: Abc tapped: " & call kmSay with (para));
                                Print("keep-ink-menu: done");
                                HostQuit();
                              end, 20);
                          end);
                      end, 20);
                  end;
              end, nil, 500);
          end);
      end, 60);
  end);
