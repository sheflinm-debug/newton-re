// Marking (docs/modern/marking.md; host/HostMarks.ns, views/CaretWriting.cpp,
// TEditView::DrawMarks).  With NEWTON_MARKING=1: "ton" is written on the
// Notepad and read; a tap on the caret brings up its pop-up, which has a
// row "* Mark" under the space bar; the row tapped marks the paragraph -
// its data frame gets `marked`, the note is saved with it, and a star is
// drawn in the margin beside it.  The Marked application (Extras) lists
// it; a tap on the row's star takes the mark off.  Without it the pop-up is
// the ROM's (ctests host.NewtonMarking and ...off).
//
//   NEWTON_MARKING=1 build/host/host/newton --display 320x480 --headless 120 //       --script src/host/demo/marking.ns
//
// Leaves build/marking-popup.pgm (the pop-up), build/marking-note.pgm (the
// star beside the line) and build/marking-list.pgm (the Marked application).

HostInclude("common.ns");			// waitFor, walkSetup

mkName := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

mkStroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

mkOval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// "ton", as keep-ink.ns writes it
mkBase := 200;
mkTon := [[66, mkBase - 24, 66, mkBase - 18, 66, mkBase - 12, 66, mkBase - 6, 66, mkBase],
          [60, mkBase - 14, 64, mkBase - 14, 68, mkBase - 14, 72, mkBase - 14],
          call mkOval with (82, mkBase - 7, 6, 7),
          [94, mkBase - 14, 94, mkBase - 7, 94, mkBase, 94, mkBase - 7,
           95, mkBase - 11, 97, mkBase - 13, 100, mkBase - 14, 103, mkBase - 13,
           104, mkBase - 10, 104, mkBase - 5, 104, mkBase]];

mkFindParagraph := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and	// clParagraphView (flags above it)
       IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call mkFindParagraph with (child, prefix);
    found;
  end;

// what the page holds, said so a test can match it: an ink word is the
// one character 0xF701
mkSay := func(para)
  begin
    local out := "";
    for i := 0 to StrLen(para.text) - 1 do
      out := out & (if Ord(para.text[i]) = 0xF701 then "<ink>" else SPrintObject(para.text[i]));
    out;
  end;

mkTap := func(x, y) begin PenDown(x, y); PenUp(); end;

// the pop-up, when it is up: the root's pick view
mkPopup := func()
  begin
    local found := nil;
    foreach child in GetRoot():ChildViewFrames() do
      if BAnd(child.viewClass, 0xFFFF) = 91 then found := child;	// clPickView
    found;
  end;

// the caret tapped, and once the pop-up is up `andThen` called with it
mkOpen := func(what, andThen)
  call waitFor with (what & ": the caret", func() GetCaretBox() and not call mkPopup with (), func() begin
      local c := GetCaretBox();
      call mkTap with ((c.left + c.right) div 2, (c.top + c.bottom) div 2);
      call waitFor with (what & ": the pop-up", mkPopup, func() call andThen with (call mkPopup with ()), 20);
    end, 20);

mkSaved := func()
  begin
    local e := GetUnionSoupAlways("Notes"):Query({}):Entry();
    e and IsArray(e.data) and e.data[0].marked;
  end;

call walkSetup with (mkName, func() begin
    foreach s in mkTon do call mkStroke with (s);
    IdleStrokes();
    call waitFor with ("marking: the word read", func() call mkFindParagraph with (GetRoot(), "ton"), func() begin
        local para := call mkFindParagraph with (GetRoot(), "ton");
        call mkOpen with ("marking", func(pop) begin
            local items := Length(pop.pickItems);
            local box := pop:GlobalBox();
            Print("marking: HostFeatureOn " & (if HostFeatureOn('marking) then "true" else "nil") & ", the pop-up has " & items & " items");
            if items < 3 then
              begin
                pop:Close();
                Print("marking: done");
                return HostQuit();
              end;
            AddDelayedCall(func() begin ScreenSnapshot("build/marking-popup.pgm"); call mkTap with ((box.left + box.right) div 2, box.bottom - 13) end, nil, 500);	// the Mark row, the last
            call waitFor with ("marking: marked", func() para._proto.marked, func() begin
                Print("marking: the paragraph marked, saved with the note " & (if call mkSaved with () then "true" else "nil"));
                AddDelayedCall(func() begin
                    ScreenSnapshot("build/marking-note.pgm");
                    local app := GetRoot().|Marked:host|;
                    app:Open();
                    call waitFor with ("marking: the list", func() app.viewCObject and app.marks, func() begin
                        Print("marking: Marked lists " & Length(app.marks) & ": " & app.marks[0].text & " in " & app.marks[0].title);
                        AddDelayedCall(func() begin
                            ScreenSnapshot("build/marking-list.pgm");
                            local lb := app.listView:GlobalBox();
                            call mkTap with (lb.left + 8, lb.top + app.listView:HeaderHeight() + 8);		// the row's star
                            call waitFor with ("marking: unmarked", func() Length(app.marks) = 0 and not para._proto.marked, func() begin
                                Print("marking: the star tapped, Marked lists " & Length(app.marks) & ", the paragraph marked " & (if para._proto.marked then "true" else "nil"));
                                Print("marking: done");
                                HostQuit();
                              end, 20);
                          end, nil, 1500);
                      end, 20);
                  end, nil, 500);
              end, 20);
          end);
      end, 60);
  end);
