// Ink read in the background, and found by Find (docs/modern/
// ink-and-text.md; views/ParagraphView.cpp's ReadInkInBackground,
// stores/InkText.h).  With NEWTON_KEEP_INK=1 the Notepad is set to keep
// writing as ink ("Ink Text", _recogSettings 64, as rereadink.ns does) and
// "ton" is written: it stays an ink word on the page.  Once the pen has been
// still a while the paragraph reads it - the page does not change, the
// reading goes inside the ink word - and the note, written to its soup, is
// found by a words query for "ton", as Find asks.  Then the Abc of the
// caret's pop-up has nothing left to read: ShowWritingAs makes it text at
// once.
//
//   NEWTON_KEEP_INK=1 build/host/host/newton --display 320x480 --headless 120 //       --script src/host/demo/keep-ink-find.ns
//
// ctest host.NewtonKeepInkFind.

HostInclude("common.ns");			// waitFor, walkSetup

kfName := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

kfStroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

kfOval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// "ton", as keep-ink.ns writes it
kfBase := 200;
kfTon := [[66, kfBase - 24, 66, kfBase - 18, 66, kfBase - 12, 66, kfBase - 6, 66, kfBase],
          [60, kfBase - 14, 64, kfBase - 14, 68, kfBase - 14, 72, kfBase - 14],
          call kfOval with (82, kfBase - 7, 6, 7),
          [94, kfBase - 14, 94, kfBase - 7, 94, kfBase, 94, kfBase - 7,
           95, kfBase - 11, 97, kfBase - 13, 100, kfBase - 14, 103, kfBase - 13,
           104, kfBase - 10, 104, kfBase - 5, 104, kfBase]];

kfFindParagraph := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and	// clParagraphView (flags above it)
       IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call kfFindParagraph with (child, prefix);
    found;
  end;

// what the page holds, said so a test can match it: an ink word is the
// one character 0xF701
kfSay := func(para)
  begin
    local out := "";
    for i := 0 to StrLen(para.text) - 1 do
      out := out & (if Ord(para.text[i]) = 0xF701 then "<ink>" else SPrintObject(para.text[i]));
    out;
  end;

kfInkPara := func(v)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and IsString(v.text) and StrLen(v.text) > 0
       and Ord(v.text[0]) = 0xF701 then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call kfInkPara with (child);
    found;
  end;

kfFound := func(word)
  begin
    local soup := GetUnionSoupAlways("Notes");
    local c := soup:Query({words: [word]});
    local n := 0;
    local e := c:Entry();
    while e do begin n := n + 1; e := c:Next() end;
    n;
  end;

call walkSetup with (kfName, func() begin
    Print("keep-ink-find: before writing, a words query for ton finds " & call kfFound with ("ton") & " notes");
    GetRoot().paperroll._recogSettings := 64;
    PurgeAreaCache();
    foreach s in kfTon do call kfStroke with (s);
    IdleStrokes();
    call waitFor with ("keep-ink-find: the ink word", func() call kfInkPara with (GetRoot()), func() begin
        local para := call kfInkPara with (GetRoot());
        Print("keep-ink-find: kept as ink, its reading at first " & (if InkReading(para.styles[1]) then "there" else "none"));
        call waitFor with ("keep-ink-find: read in the background", func() InkReading(para.styles[1]), func() begin
            Print("keep-ink-find: read in the background: " & SPrintObject(InkReading(para.styles[1]))
                  & ", the page still " & call kfSay with (para));
            call waitFor with ("keep-ink-find: found", func() call kfFound with ("ton") > 0, func() begin
                Print("keep-ink-find: a words query for ton finds " & call kfFound with ("ton") & " note");
                ShowWritingAs(para, nil, nil, 'text);
                Print("keep-ink-find: shown as text at once: " & call kfSay with (para));
                Print("keep-ink-find: done");
                HostQuit();
              end, 30);
          end, 30);
      end, 30);
  end);
