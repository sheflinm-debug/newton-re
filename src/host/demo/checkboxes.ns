// Checkboxes in a note (docs/modern/structure.md, first version;
// views/MarginMarks.h, host/HostMarks.ns).  With NEWTON_STRUCTURE=1: "ton"
// is written on the Notepad and read; the caret's pop-up has a row
// "[] To do", which makes the paragraph a to-do item - a checkbox in the
// margin; a tap on the box ticks it, another unticks it.  Then the
// paragraph's text is made "[x] milk": a checkbox written as text is
// offered (a dotted box), and a tap on it accepts - the text "milk", the
// item ticked; and "1. eggs" likewise offered as a numbered list item.
// Without it the pop-up is the ROM's (ctests
// host.NewtonCheckboxes and ...off).
//
//   NEWTON_STRUCTURE=1 build/host/host/newton --display 320x480 --headless 120 //       --script src/host/demo/checkboxes.ns
//
// Leaves build/checkboxes-offer.pgm (the offer) and build/checkboxes.pgm
// (the item taken from it, ticked).

HostInclude("common.ns");			// waitFor, walkSetup

ckName := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

ckStroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

ckOval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// "ton", as keep-ink.ns writes it
ckBase := 200;
ckTon := [[66, ckBase - 24, 66, ckBase - 18, 66, ckBase - 12, 66, ckBase - 6, 66, ckBase],
          [60, ckBase - 14, 64, ckBase - 14, 68, ckBase - 14, 72, ckBase - 14],
          call ckOval with (82, ckBase - 7, 6, 7),
          [94, ckBase - 14, 94, ckBase - 7, 94, ckBase, 94, ckBase - 7,
           95, ckBase - 11, 97, ckBase - 13, 100, ckBase - 14, 103, ckBase - 13,
           104, ckBase - 10, 104, ckBase - 5, 104, ckBase]];

ckFindParagraph := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and	// clParagraphView (flags above it)
       IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call ckFindParagraph with (child, prefix);
    found;
  end;

// what the page holds, said so a test can match it: an ink word is the
// one character 0xF701
ckSay := func(para)
  begin
    local out := "";
    for i := 0 to StrLen(para.text) - 1 do
      out := out & (if Ord(para.text[i]) = 0xF701 then "<ink>" else SPrintObject(para.text[i]));
    out;
  end;

ckTap := func(x, y) begin PenDown(x, y); PenUp(); end;

// the pop-up, when it is up: the root's pick view
ckPopup := func()
  begin
    local found := nil;
    foreach child in GetRoot():ChildViewFrames() do
      if BAnd(child.viewClass, 0xFFFF) = 91 then found := child;	// clPickView
    found;
  end;

// the caret tapped, and once the pop-up is up `andThen` called with it
ckOpen := func(what, andThen)
  call waitFor with (what & ": the caret", func() GetCaretBox() and not call ckPopup with (), func() begin
      local c := GetCaretBox();
      call ckTap with ((c.left + c.right) div 2, (c.top + c.bottom) div 2);
      call waitFor with (what & ": the pop-up", ckPopup, func() call andThen with (call ckPopup with ()), 20);
    end, 20);

// where the margin's box is for a paragraph (MarginMarks.cpp's ItemsOf,
// no star): its centre
ckBox := func(para)
  begin
    local pb := para:GlobalBox();
    local eb := para._parent:GlobalBox();
    local left := Max(pb.left - 11, eb.left + 1);
    {x: left + 4, y: pb.top + 7};
  end;

ckState := func(para) if para._proto.check then para._proto.check else 'none;

call walkSetup with (ckName, func() begin
    foreach s in ckTon do call ckStroke with (s);
    IdleStrokes();
    call waitFor with ("checkboxes: the word read", func() call ckFindParagraph with (GetRoot(), "ton"), func() begin
        local para := call ckFindParagraph with (GetRoot(), "ton");
        call ckOpen with ("checkboxes", func(pop) begin
            local items := Length(pop.pickItems);
            local box := pop:GlobalBox();
            Print("checkboxes: HostFeatureOn " & (if HostFeatureOn('structure) then "true" else "nil") & ", the pop-up has " & items & " items");
            if items < 3 then
              begin
                pop:Close();
                // the margin does nothing either: the tap puts the caret there
                local c := call ckBox with (para);
                call ckTap with (c.x, c.y);
                AddDelayedCall(func() begin
                    Print("checkboxes: a tap in the margin, the paragraph " & call ckState with (para));
                    Print("checkboxes: done");
                    HostQuit();
                  end, nil, 1500);
                return;
              end;
            AddDelayedCall(func() call ckTap with ((box.left + box.right) div 2, box.bottom - 13), nil, 500);	// To do, the last row
            call waitFor with ("checkboxes: an item", func() para._proto.check, func() begin
                Print("checkboxes: To do picked, the paragraph " & call ckState with (para));
                local c := call ckBox with (para);
                AddDelayedCall(func() call ckTap with (c.x, c.y), nil, 800);
                call waitFor with ("checkboxes: ticked", func() para._proto.check = 'done, func() begin
                    Print("checkboxes: the box tapped, " & call ckState with (para));
                    AddDelayedCall(func() call ckTap with (c.x, c.y), nil, 800);
                    call waitFor with ("checkboxes: unticked", func() para._proto.check = 'open, func() begin
                        Print("checkboxes: tapped again, " & call ckState with (para));
                        // an offer: the item made a plain paragraph again, its text "[x] milk"
                        GetGlobalVar('|HostMarks:host|):ToggleChecks([para]);
                        SetValue(para, 'text, "[x] milk");
                        AddDelayedCall(func() begin
                            Print("checkboxes: written [x] milk, the paragraph " & call ckState with (para));
                            ScreenSnapshot("build/checkboxes-offer.pgm");
                            local c2 := call ckBox with (para);
                            call ckTap with (c2.x, c2.y);
                            call waitFor with ("checkboxes: the offer taken", func() para._proto.check, func() begin
                                Print("checkboxes: the offer tapped, the text " & para.text & ", the paragraph " & call ckState with (para));
                                AddDelayedCall(func() begin
                                    ScreenSnapshot("build/checkboxes.pgm");
                                    // a list item written as text: "1. eggs" offered, accepted
                                    GetGlobalVar('|HostMarks:host|):ToggleChecks([para]);
                                    SetValue(para, 'text, "1. eggs");
                                    AddDelayedCall(func() begin
                                        local c3 := call ckBox with (para);
                                        call ckTap with (c3.x, c3.y);
                                        call waitFor with ("checkboxes: the list offer taken", func() para._proto.list, func() begin
                                            Print("checkboxes: 1. eggs tapped, the text " & para.text & ", a list item " & para._proto.list);
                                            AddDelayedCall(func() begin
                                                ScreenSnapshot("build/checkboxes-list.pgm");
                                                Print("checkboxes: done");
                                                HostQuit();
                                              end, nil, 800);
                                          end, 20);
                                      end, nil, 800);
                                  end, nil, 800);
                              end, 20);
                          end, nil, 800);
                      end, 20);
                  end, 20);
              end, 20);
          end);
      end, 60);
  end);
