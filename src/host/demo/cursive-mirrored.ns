// Cursive, mirrored: with NEWTON_INK_MIRROR=1 (recognition/InkMirror.h,
// docs/recognition/arabic.md) the reader is handed the writing turned
// left to right, as writing in a right-to-left script needs.  "ton" from
// cursive.ns is written here as its own mirror image - every stroke
// turned about x = 260, so the word runs right to left from x = 200 to
// x = 156 - and the reader, given it turned back, reads "ton" as
// cursive.ns's does.  The word's box comes back from the mirrored trace
// and is turned back again, so the word is put on the page where its ink
// was: the script prints the paragraph's left and right.
//
//   NEWTON_INK_MIRROR=1 NEWTON_TRACE_CURSIVE=1 build/host/host/newton
//       --display 320x480 --script src/host/demo/cursive-mirrored.ns --headless 60
//
// ctest host.NewtonCursiveMirrored.  Otherwise as src/host/demo/cursive.ns.

HostInclude("common.ns");			// stroke helpers, waitFor, walkSetup

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

mirrorAxis := 260;

// One stroke, mirrored: the pen put down on the first point, moved
// through the rest, and lifted, every x turned about mirrorAxis.
mirroredStroke := func(points)
  begin
    PenDown(mirrorAxis - points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(mirrorAxis - points[i], points[i + 1]);
    PenUp();
  end;

// the first paragraph view under v whose text starts with `prefix`
findParagraph := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call findParagraph with (child, prefix);
    found;
  end;

// An oval of `n` points, from the top going anticlockwise, as an o is
// written (cursive.ns's).
oval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

call walkSetup with (name, func() begin
    local base := 200;
    SetUserConfig('letterSetSelection, 0);
    ReadCursiveOptions();
    Print("mirrored: the letter set is" && GetUserConfig('letterSetSelection));
    // cursive.ns's "ton", each stroke mirrored as it is written
    foreach s in [[66, base - 24, 66, base - 18, 66, base - 12, 66, base - 6, 66, base],
                  [60, base - 14, 64, base - 14, 68, base - 14, 72, base - 14],
                  call oval with (82, base - 7, 6, 7),
                  [94, base - 14, 94, base - 7, 94, base, 94, base - 7,
                   95, base - 11, 97, base - 13, 100, base - 14, 103, base - 13,
                   104, base - 10, 104, base - 5, 104, base]] do
      call mirroredStroke with (s);
    Print("mirrored: the ink spans x" && mirrorAxis - 104 && "to" && mirrorAxis - 60);
    IdleStrokes();
    call waitFor with ("mirrored: ton read", func() call findParagraph with (GetRoot(), "ton"), func() begin
        local p := call findParagraph with (GetRoot(), "ton");
        local box := p:GlobalBox();
        ScreenSnapshot("build/cursive-mirrored.pgm");
        Print("mirrored: the page reads \"" & p.text & "\"");
        Print("mirrored: the paragraph spans x" && box.left && "to" && box.right);
        Print("mirrored: done");
        HostQuit();
      end, 60);
  end);
Print("mirrored: the script is loaded");
