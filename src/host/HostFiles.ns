// Files: a folder of the host's, browsed on the Newton (docs/modern/files.md).
// Compiled into newton (HostFilesSource.cpp, made by
// src/cmake/EmbedText.cmake) and evaluated at boot by HostInstallFiles
// (host/HostFiles.cpp); the frame is kept in the global HostFiles:host.
//
// DEVIATION (host addition, host/Features.h's kFeatureFiles - the Host
// panel's "Files", NEWTON_FILES): the ROM has no files, only entries in
// soups.  With this on, the Files application in Extras shows the host's
// folder (NEWTON_FILES_ROOT, or "Newton Files" in the user's home, with
// Documents, Downloads, Pictures, Music and Received in it): its folders,
// and each file's kind and size.  A tap on a folder opens it; a tap on a
// text or Markdown file makes a note of it (files.md's first level,
// "translate into Newton data": paragraphs split at blank lines, a
// Markdown heading in bold) and opens the note in the Notepad.  The file
// itself is left as it is; the note remembers it in `fromFile`.
//
// Files as entries: every file under the folder is an entry of the soup
// "Files" on the internal store - {class: 'file, name, path, kind, size,
// modified, labels, disk, excerpt} - kept in step with the folder (Sync,
// every few seconds, from HostFilesScan; a scan that changed anything
// sends one 'whatThe notification).  Find finds them (RegFindApps; the
// ROM's StandardFind over the soup, by name and, for a text file, by the
// words of its first 2000 characters, `excerpt`).  An entry changed by
// someone else - its name or path - renames or moves the file; an entry
// removed by someone else moves the file to the hidden ".Trash" folder.
// `disk` is where the file was last seen, so a change is done once
// whatever order the deferred notifications and the scans come in.
//
// NOT YET (files.md): the entries are a soup of the internal store kept
// in step, not a store of their own (TFileStore): their content is read
// through the natives, not a binary paged from the file; the folder is
// looked at every few seconds rather than watched (the host's change
// notification); drives are not stores; labels are kept in the entry, not
// beside the file; folders are not entries.  Other kinds are listed but
// not opened.

{
	appSymbol: '|Files:host|,

	// the kinds of file, by the name's ending
	kinds: {
		txt: "Text", text: "Text", md: "Markdown", markdown: "Markdown", csv: "Table (CSV)",
		pdf: "PDF document", jpg: "JPEG picture", jpeg: "JPEG picture", png: "PNG picture",
		gif: "GIF picture", webp: "WebP picture", heic: "HEIC picture",
		mp3: "MP3 sound", wav: "WAV sound", m4a: "AAC sound", mp4: "MP4 video", mov: "QuickTime video",
		doc: "Word document", docx: "Word document", odt: "OpenDocument text",
		xls: "Excel workbook", xlsx: "Excel workbook", ppt: "PowerPoint deck", pptx: "PowerPoint deck",
		rtf: "RTF document", html: "Web page", htm: "Web page", vcf: "vCard", ics: "iCalendar",
		zip: "ZIP archive", epub: "EPUB book", pkg: "Newton package"
	},
	// the kinds a note can be made of
	textKinds: ["Text", "Markdown", "Table (CSV)"],

	app: {
		viewClass: 74,							// clView
		viewFlags: 5,							// vVisible, vApplication
		viewFormat: 273,						// white, a one-pixel black frame
		viewBounds: {left: 0, top: 0, right: 240, bottom: 320},
		declareSelf: 'base,
		viewFont: 10240,
		appSymbol: '|Files:host|,
		title: "Files",
		ReOrientToScreen: func() :Relayout(),

		kFont: 10240,							// the system font, 10 point
		kBold: 1058816,							// bold
		kSmall: 9216,							// 9 point

		folder: "",								// the folder shown, relative to the root
		items: nil,								// its entries (HostFilesList)
		scroll: 0,								// rows scrolled past
		status: nil,							// a line about the last tap
		listView: nil,

		viewSetupFormScript: func()
		begin
			local p := GetAppParams();
			viewBounds := RelBounds(p.appAreaLeft, p.appAreaTop, p.appAreaWidth, p.appAreaHeight);
		end,

		viewSetupDoneScript: func()
		begin
			foreach v in :ChildViewFrames() do
				if v.role then
					self.(v.role) := v;
			:Reload();
			:Layout();
		end,

		viewQuitScript: func()
		begin
			listView := nil;
			items := nil;
		end,

		// Find (RegFindApps): the ROM's own search of a soup
		Find: func(what, results, scope, statusForm)
			:StandardFind(what, "Files", results, statusForm, nil),

		FindSoupExcerpt: func(entry, finder)
			if StrLen(entry.path) > 0 then entry.name & "  (" & entry.path & ")" else entry.name,

		// (the ROM's finder calls OpenTo, when there is one, instead of
		// opening the application and calling ShowFoundItem: a text file's
		// note is opened without the Files application over it)
		OpenTo: func(entry, finder)
			GetGlobalVar('|HostFiles:host|):OpenEntry(entry),

		ShowFoundItem: func(entry, finder)
			GetGlobalVar('|HostFiles:host|):OpenEntry(entry),

		Relayout: func()
		begin
			local p := GetAppParams();
			SetValue(self, 'viewBounds, RelBounds(p.appAreaLeft, p.appAreaTop, p.appAreaWidth, p.appAreaHeight));
			:Layout();
		end,

		Layout: func()
		begin
			local box := :LocalBox();
			SetValue(listView, 'viewBounds, RelBounds(0, 0, box.right, box.bottom));
		end,

		Reload: func()
		begin
			HostFilesRoot();
			local listed := HostFilesList(folder);
			items := if listed then listed else [];
			if scroll >= Length(items) then scroll := 0;
			if listView then listView:Dirty();
		end,

		// a folder shown: "" the root, else names joined by "/"
		Show: func(path)
		begin
			folder := path;
			scroll := 0;
			status := nil;
			:Reload();
		end,

		Up: func()
		begin
			local cut := nil;
			for i := StrLen(folder) - 1 to 0 by -1 do
				if not cut and folder[i] = $/ then cut := i;
			:Show(if cut then SubStr(folder, 0, cut) else "");
		end,

		Tapped: func(item)
		begin
			local path := if StrLen(folder) > 0 then folder & "/" & item.name else item.name;
			if item.folder then return :Show(path);
			local files := GetGlobalVar('|HostFiles:host|);
			local kind := files:KindOf(item.name);
			if kind and files:IsText(kind) then begin
				// (closed first, as Find's slip is, so the note is in front)
				status := nil;
				:Close();
				files:OpenAsNote(path, item.name, kind);
			end else if files:ShowInGallery(path) then
				status := nil
			else begin
				status := (if kind then kind else "This kind of file") & ": no viewer yet";
				listView:Dirty();
			end;
		end,

		viewChildren: [
			{
				viewClass: 74, viewFlags: 513, viewFormat: 0, role: 'listView,
				viewBounds: {left: 0, top: 0, right: 240, bottom: 300},
				HeaderHeight: func() FontHeight(:Parent().kBold) + FontHeight(:Parent().kSmall) + 14,
				RowHeight: func() FontHeight(:Parent().kBold) + FontHeight(:Parent().kSmall) + 10,
				viewDrawScript: func()
				begin
					local base := :Parent();
					local files := GetGlobalVar('|HostFiles:host|);
					local b := :LocalBox();
					local w := b.right;
					local hh := :HeaderHeight();
					local bh := FontHeight(base.kBold);
					:DrawShape(MakeText("Files", 8, 4, w div 2, 4 + bh), {font: base.kBold});
					local cw := StrFontWidth("Close", base.kBold);
					:DrawShape(MakeRoundRect(w - cw - 12, 2, w - 3, 4 + bh + 2, 4), {penSize: 1});
					:DrawShape(MakeText("Close", w - cw - 7, 4, w - 4, 4 + bh), {font: base.kBold});
					local where := if StrLen(base.folder) > 0 then "< " & base.folder else "Newton Files";
					if base.status then where := base.status;
					:DrawShape(MakeText(StyledStrTruncate(where, w - 16, base.kSmall), 8, bh + 8, w - 4, hh - 2), {font: base.kSmall});
					:DrawShape(MakeLine(0, hh - 1, w, hh - 1), {penSize: 1});
					local count := if base.items then Length(base.items) else 0;
					if count = 0 then begin
						:DrawShape(MakeText("This folder is empty.", 12, hh + 12, w - 12, hh + 30), {font: base.kFont});
						return;
					end;
					local rowH := :RowHeight();
					local y := hh;
					local i := base.scroll;
					while i < count and y < b.bottom do begin
						local item := base.items[i];
						if item.folder then
							files:DrawFolder(self, 8, y + 6)
						else
							files:DrawPage(self, 10, y + 4);
						:DrawShape(MakeText(StyledStrTruncate(item.name, w - 40, base.kBold), 30, y + 4, w - 6, y + 4 + bh),
							{font: base.kBold});
						local under := if item.folder then "Folder"
							else (if files:KindOf(item.name) then files:KindOf(item.name) else "File") & ", " & files:SizeText(item.size);
						:DrawShape(MakeText(under & "  " & ShortDate(item.modified), 30, y + 6 + bh, w - 6, y + rowH - 2),
							{font: base.kSmall});
						:DrawShape(MakeLine(4, y + rowH - 1, w - 4, y + rowH - 1), {penSize: 1, penPattern: 3});
						y := y + rowH;
						i := i + 1;
					end;
				end,
				viewClickScript: func(unit)
				begin
					local base := :Parent();
					local box := :GlobalBox();
					local y := GetPoint(5, unit) - box.top - :HeaderHeight();
					local x := GetPoint(4, unit) - box.left;
					if y < 0 then begin
						// Close at the right of the title; the path line goes up a folder
						if y < -FontHeight(base.kSmall) - 6 then begin
							if x > box.right - box.left - StrFontWidth("Close", base.kBold) - 14 then base:Close()
							else base:ScrollBy(-1);
						end else if StrLen(base.folder) > 0 then
							base:Up();
						return true;
					end;
					if not base.items then return true;
					local i := base.scroll + y div :RowHeight();
					if i >= Length(base.items) then
						base:ScrollBy(1)
					else
						base:Tapped(base.items[i]);
					true;
				end
			}
		],

		ScrollBy: func(pages)
		begin
			if not items then return;
			local rows := Max(1, ((listView:LocalBox()).bottom - listView:HeaderHeight()) div listView:RowHeight());
			local was := scroll;
			scroll := Max(0, Min(scroll + pages * rows, Length(items) - 1));
			if scroll = was and pages > 0 then scroll := 0;
			listView:Dirty();
		end
	},

	// --- the Files transport: "Save a copy to a folder" (transports.md) ---
	//
	// A transport of the In/Out Box as HostText.ns's is (protoTransport
	// @389, its slip protoFullRouteSlip @655), registered while Files is on:
	// the Action button of every application offers "Save to Files" for
	// whatever has a 'text or 'frame format.  The slip's Folder line picks
	// one of the Files folder's standard folders (Documents by default),
	// its As line Text or Newton data (`saveAs`, 'text by default); the
	// item's title names the file.  As text, the format's TextScript is
	// written as name.txt (UTF-8); as Newton data, the item's data as
	// name.nsof (the Newton's own streamed object format, Translate's
	// 'flattener - what Beam sends).  A name taken gets a number.  A file that cannot be
	// written leaves the item in the Out Box with the reason.
	// NOT YET (transports.md): a note's ink and shapes as PDF or PNG, a
	// picture as its own file, a .nsof put back into its application.

	transport: {
		_proto: @389,							// protoTransport
		appSymbol: '|SaveToFiles:host|,
		title: "Files",
		actionTitle: "Save to Files",
		dataTypes: ['text, 'frame],
		icon: @760,
		kWriteFailed: -54101,
		defaultFolder: "Documents",

		routingSlip: {
			_proto: @655,						// protoFullRouteSlip
			stepChildren: [
				{
					viewClass: 74,				// clView
					viewFlags: 513,				// vVisible, vClickable
					viewFormat: 0,
					viewBounds: {left: 30, top: 50, right: -20, bottom: 66},
					viewJustify: 48,				// vjParentFullH: the right edge from the slip's
					// (the slip's parent is the root, not the transport: its own list)
					folders: ["Documents", "Downloads", "Pictures", "Music", "Received"],
					viewSetupFormScript: func()
					begin
						if not fields.saveFolder then fields.saveFolder := folders[0];
					end,
					viewDrawScript: func()
					begin
						local b := :LocalBox();
						:DrawShape(MakeText("Folder", 0, 1, 50, b.bottom), {font: 1058816});
						:DrawShape(MakeText(fields.saveFolder, 52, 1, b.right, b.bottom), {font: 10240});
						:DrawShape(MakeLine(50, b.bottom - 1, b.right, b.bottom - 1), {penSize: 1, penPattern: 3});
					end,
					viewClickScript: func(unit)
					begin
						DoPopup(folders, 52, 16, self);
						true;
					end,
					pickActionScript: func(index)
					begin
						fields.saveFolder := folders[index];
						:Dirty();
					end
				},
				{
					// how: the text (.txt) or the Newton's own data (.nsof)
					viewClass: 74,
					viewFlags: 513,
					viewFormat: 0,
					viewBounds: {left: 30, top: 70, right: -20, bottom: 86},
					viewJustify: 48,				// vjParentFullH: the right edge from the slip's
					kinds: ['text, 'frame],
					names: ["Text", "Newton data"],
					viewSetupFormScript: func()
					begin
						if not fields.saveAs then fields.saveAs := 'text;
					end,
					viewDrawScript: func()
					begin
						local b := :LocalBox();
						:DrawShape(MakeText("As", 0, 1, 50, b.bottom), {font: 1058816});
						:DrawShape(MakeText(if fields.saveAs = 'frame then names[1] else names[0], 52, 1, b.right, b.bottom), {font: 10240});
						:DrawShape(MakeLine(50, b.bottom - 1, b.right, b.bottom - 1), {penSize: 1, penPattern: 3});
					end,
					viewClickScript: func(unit)
					begin
						DoPopup(names, 52, 16, self);
						true;
					end,
					pickActionScript: func(index)
					begin
						fields.saveAs := kinds[index];
						:Dirty();
					end
				}
			]
		},

		TranslateError: func(error)
		begin
			if error = kWriteFailed then
				"The file could not be written."
			else
				inherited:TranslateError(error);
		end,

		ReceiveRequest: func(request) nil,

		SendRequest: func(request)
		begin
			if request.cause = 'submit then
				return nil;
			local item;
			loop begin
				try
					item := self:ItemRequest(request)
				onexception |evt.ex| do begin
					self:HandleThrow();
					item := nil;
				end;
				if not item then break;
				local path := self:SaveItem(item);
				if path then
					self:ItemCompleted(item, 'sent, nil)
				else
					self:ItemCompleted(item, nil, kWriteFailed);
			end;
			self:SetStatusDialog('idle, nil, nil);
		end,

		// the item written ==> its path, nil when it could not be
		SaveItem: func(item)
		begin
			local files := GetGlobalVar('|HostFiles:host|);
			local folder := if IsString(item.saveFolder) then item.saveFolder else defaultFolder;
			local name := self:FileName(item.title);
			local format := GetCurrentFormat(item);
			local types := if format then format.dataTypes else nil;
			local body := item.body;
			if format and format.ResolveBody then
				try body := format:ResolveBody(item) onexception |evt.ex| do nil;
			HostFilesRoot();
			// (the formats of Notes and Names take both: the item's saveAs,
			// the slip's "As" line, chooses - text unless it says 'frame)
			local wantText := IsString(body) or (types and SetContains(types, 'text) and item.saveAs <> 'frame);
			if wantText then begin
				local text := if IsString(body) then body else nil;
				if not text then
					try text := format:TextScript(item, body) onexception |evt.ex| do text := nil;
				if not IsString(text) then return nil;
				local path := self:FreePath(folder, name, "txt");
				if HostFilesWriteText(path, text) then begin
					Print("files: saved " & path);
					return path;
				end;
				return nil;
			end;
			if not IsFrame(body) then return nil;
			local flat := nil;
			try flat := Translate(body, 'flattener, nil, nil) onexception |evt.ex| do flat := nil;
			if not flat then return nil;
			local path := self:FreePath(folder, name, "nsof");
			if HostFilesWriteBinary(path, flat) then begin
				Print("files: saved " & path & ", " & Length(flat) & " bytes");
				return path;
			end;
			nil;
		end,

		// a title made a file name: what no file system takes left out
		FileName: func(title)
		begin
			local out := "";
			if IsString(title) then
				for i := 0 to StrLen(title) - 1 do begin
					local c := title[i];
					if not (c = $/ or c = $\\ or c = $: or c = $* or c = $? or c = $" or c = $< or c = $> or c = $| or Ord(c) < 32) then
						out := out & c;
				end;
			out := GetGlobalVar('|HostFiles:host|):Trim(out);
			while StrLen(out) > 0 and out[StrLen(out) - 1] = $. do out := SubStr(out, 0, StrLen(out) - 1);
			if StrLen(out) = 0 then "Untitled" else out;
		end,

		// folder/name.ending, or with " 2", " 3", ... when the name is taken
		FreePath: func(folder, name, ending)
		begin
			local path := folder & "/" & name & "." & ending;
			local n := 2;
			while HostFilesExists(path) do begin
				path := folder & "/" & name & " " & NumberStr(n) & "." & ending;
				n := n + 1;
			end;
			path;
		end
	},

	// whether notes can be made of a kind
	IsText: func(kind)
	begin
		foreach k in textKinds do
			if StrEqual(k, kind) then return true;
		nil;
	end,

	// a file's kind from its name's ending (nil: not known)
	KindOf: func(name)
	begin
		local dot := nil;
		for i := StrLen(name) - 1 to 0 by -1 do
			if not dot and name[i] = $. then dot := i;
		if not dot then return nil;
		local ending := Downcase(SubStr(name, dot + 1, StrLen(name) - dot - 1));
		local slot := Intern(ending);
		if HasSlot(kinds, slot) then kinds.(slot) else nil;
	end,

	SizeText: func(bytes)
	begin
		if bytes < 1024 then NumberStr(bytes) & " bytes"
		else if bytes < 1048576 then NumberStr((bytes + 512) div 1024) & " KB"
		else NumberStr((bytes + 524288) div 1048576) & " MB";
	end,

	DrawFolder: func(view, x, y)
	begin
		view:DrawShape(MakeRect(x, y + 2, x + 16, y + 13), {penSize: 1});
		view:DrawShape(MakeRect(x, y, x + 7, y + 3), {penSize: 1});
	end,

	DrawPage: func(view, x, y)
	begin
		view:DrawShape(MakeRect(x, y, x + 12, y + 16), {penSize: 1});
		for k := 0 to 2 do
			view:DrawShape(MakeLine(x + 3, y + 5 + k * 3, x + 9, y + 5 + k * 3), {penSize: 1});
	end,

	// A text file made a note: its paragraphs split at blank lines, a
	// Markdown heading ("# ...") in bold.  ==> the note's entry.
	OpenAsNote: func(path, name, kind)
	begin
		local text := HostFilesReadText(path, 30000);
		if not text then return nil;
		local blocks := [];
		local current := "";
		local line := "";
		// (a line at a time: a blank one ends a paragraph)
		for i := 0 to StrLen(text) do begin
			local c := if i < StrLen(text) then text[i] else nil;
			if not c or c = $\n then begin
				if StrLen(:Trim(line)) = 0 then begin
					if StrLen(current) > 0 then AddArraySlot(blocks, current);
					current := "";
				end else if StrEqual(kind, "Markdown") and BeginsWith(line, "#") then begin
					if StrLen(current) > 0 then AddArraySlot(blocks, current);
					current := "";
					local h := 0;
					while h < StrLen(line) and line[h] = $# do h := h + 1;
					AddArraySlot(blocks, {heading: :Trim(SubStr(line, h, StrLen(line) - h))});
				end else
					current := if StrLen(current) > 0 then current & "\n" & line else line;
				line := "";
			end else
				line := line & c;
		end;
		if StrLen(current) > 0 then AddArraySlot(blocks, current);
		local p := GetAppParams();
		local width := p.appAreaWidth - 20;
		// (the Notepad's own paragraph font, and it bold - 1 << 20 is the bold face)
		local plain := 18435;
		local bold := 18435 + 1048576;
		local data := [];
		local y := 6;
		foreach b in blocks do begin
			local t := if IsFrame(b) then b.heading else b;
			local font := if IsFrame(b) then bold else plain;
			local lines := 1;
			foreach piece in :Lines(t) do
				lines := lines + StrFontWidth(piece, font) div Max(1, width - 8);
			lines := lines + Length(:Lines(t)) - 1;
			local h := lines * (FontHeight(font) + 2) + 4;
			AddArraySlot(data, {viewStationery: 'para, viewBounds: {left: 10, top: y, right: 10 + width, bottom: y + h},
				text: t, viewFont: font});
			y := y + h + 4;
		end;
		local note := {class: 'paperroll, viewStationery: 'paperroll, timestamp: Time(), height: Max(y + 10, 60),
			labels: nil, data: data, fromFile: path};
		local entry := GetUnionSoup("Notes"):AddToDefaultStoreXmit(note, nil);
		Print("files: " & path & " made a note of " & Length(data) & " paragraphs");
		local notepad := GetRoot().paperroll;
		if notepad then begin
			notepad:Open();
			notepad:ShowFoundItem(entry, nil);
		end;
		entry;
	end,

	// a string's lines (split at returns)
	Lines: func(t)
	begin
		local out := [];
		local start := 0;
		for i := 0 to StrLen(t) do
			if i = StrLen(t) or t[i] = $\n then begin
				AddArraySlot(out, SubStr(t, start, i - start));
				start := i + 1;
			end;
		out;
	end,

	Trim: func(s)
	begin
		local a := 0;
		local b := StrLen(s);
		while a < b and (s[a] = $  or Ord(s[a]) = 9) do a := a + 1;
		while b > a and (s[b - 1] = $  or Ord(s[b - 1]) = 9) do b := b - 1;
		SubStr(s, a, b - a);
	end,

	// a folder for the Extras drawer
	MakeIcon: func()
	begin
		local bitmap := MakeBitmap(28, 26, nil);
		DrawIntoBitmap(MakeRect(2, 7, 26, 24), {penSize: 2}, bitmap);
		DrawIntoBitmap(MakeRect(2, 3, 12, 8), {penSize: 2}, bitmap);
		bitmap;
	end,

	IconEntry: func()
	begin
		local extras := GetUnionSoup(@307.name);
		if not extras then return nil;
		local cursor := Query(extras, {type: 'index});
		local e;
		while (e := cursor:Entry()) do begin
			if e.app = appSymbol then return e;
			cursor:Next();
		end;
		nil;
	end,

	// --- the Files soup ------------------------------------------------

	soupName: "Files",
	pollMilliseconds: 3000,				// how often the folder is looked at
	excerptChars: 2000,					// a text file's words Find searches
	signature: nil,						// the tree's when it was last read
	generation: 0,						// the watch loop's (a new one ends the old)

	// a path and a name joined ("" the root)
	Join: func(path, name)
		if StrLen(path) > 0 then path & "/" & name else name,

	// the folder of a path, and its last name
	FolderOf: func(disk)
	begin
		for i := StrLen(disk) - 1 to 0 by -1 do
			if disk[i] = $/ then return SubStr(disk, 0, i);
		"";
	end,

	NameOf: func(disk)
	begin
		for i := StrLen(disk) - 1 to 0 by -1 do
			if disk[i] = $/ then return SubStr(disk, i + 1, StrLen(disk) - i - 1);
		disk;
	end,

	Soup: func()
	begin
		local store := GetStores()[0];
		if not store:HasSoup(soupName) then
			store:CreateSoupXmit(soupName, [{structure: 'slot, path: 'path, type: 'string}], nil);
		store:GetSoup(soupName);
	end,

	ExcerptOf: func(disk, name)
	begin
		local kind := :KindOf(name);
		if kind and :IsText(kind) then HostFilesReadText(disk, excerptChars) else nil;
	end,

	// The soup brought into step with the folder.  ==> how many entries
	// changed (nil: the folder had not changed).
	Sync: func()
	begin
		local scan := HostFilesScan(signature);
		if not scan then return nil;
		local soup := :Soup();
		// the entries there are, by where their files were
		local known := {};
		local cursor := soup:Query({});
		local e := cursor:Entry();
		local stale := [];
		while e do begin
			local key := if IsString(e.disk) then Intern(e.disk) else nil;
			// (two the same but for case are one symbol: the second goes)
			if not key or known.(key) then AddArraySlot(stale, e) else known.(key) := e;
			e := cursor:Next();
		end;
		local changed := 0;
		foreach f in scan.files do begin
			local disk := :Join(f.path, f.name);
			local key := Intern(disk);
			e := known.(key);
			if e then begin
				RemoveSlot(known, key);
				if e.size <> f.size or e.modified <> f.modified then begin
					// (its name and path are left: a rename may be on its way)
					e.size := f.size;
					e.modified := f.modified;
					e.excerpt := :ExcerptOf(disk, f.name);
					EntryChange(e);
					changed := changed + 1;
				end;
			end else begin
				soup:Add({class: 'file, name: f.name, path: f.path, kind: :KindOf(f.name),
					size: f.size, modified: f.modified, labels: nil, disk: disk,
					excerpt: :ExcerptOf(disk, f.name)});
				changed := changed + 1;
			end;
		end;
		// files gone: their entries go
		foreach slot, e in known do AddArraySlot(stale, e);
		foreach e in stale do begin
			EntryRemoveFromSoup(e);
			changed := changed + 1;
		end;
		signature := scan.signature;
		if changed > 0 then begin
			Print("files: the Files soup brought into step, " & changed & " changed");
			XmitSoupChange(soupName, appSymbol, 'whatThe, nil);
			local base := GetRoot().(appSymbol);
			if base and base.viewCObject then base:Reload();
		end;
		changed;
	end,

	// a change to the soup made by someone else: done to the file
	SoupChanged: func(soupName, appSym, changeType, changeData)
	begin
		if appSym = appSymbol then return;
		if changeType = 'entryChanged and IsFrame(changeData) and IsString(changeData.disk) then begin
			local e := changeData;
			if not IsString(e.name) or StrLen(e.name) = 0 then return;
			local want := :Join(if IsString(e.path) then e.path else "", e.name);
			if StrEqual(want, e.disk) then return;
			if HostFilesMove(e.disk, want) then begin
				Print("files: " & e.disk & " moved to " & want);
				e.disk := want;
			end else begin
				// (it could not be: the entry goes back to the file)
				e.name := :NameOf(e.disk);
				e.path := :FolderOf(e.disk);
			end;
			EntryChangeXmit(e, appSymbol);
		end
		else if changeType = 'entryRemoved and IsFrame(changeData) and IsFrame(changeData.entry) then begin
			local disk := changeData.entry.disk;
			if IsString(disk) and HostFilesExists(disk) = 'file then :MoveToTrash(disk);
		end;
	end,

	// a file moved to ".Trash" (a number added when the name is taken there)
	MoveToTrash: func(disk)
	begin
		local name := :NameOf(disk);
		local dest := ".Trash/" & name;
		local n := 2;
		while HostFilesExists(dest) do begin
			dest := ".Trash/" & NumberStr(n) & " " & name;
			n := n + 1;
		end;
		if HostFilesMove(disk, dest) then Print("files: " & disk & " moved to the trash");
	end,

	// an entry opened: a note of a text file, else the folder it is in
	OpenEntry: func(entry)
	begin
		local kind := :KindOf(entry.name);
		local base := GetRoot().(appSymbol);
		if kind and :IsText(kind) then begin
			// (the Notepad is the backdrop: an application open hides it)
			if base and base.viewCObject then base:Close();
			return :OpenAsNote(entry.disk, entry.name, kind);
		end;
		if :ShowInGallery(entry.disk) then return entry;
		if not base then return nil;
		base:Open();
		base:Show(entry.path);
		base.status := entry.name & ": " & (if kind then kind else "a file") & ", no viewer yet";
		if base.listView then base.listView:Dirty();
		entry;
	end,

	// a picture shown in the Gallery (host/HostGallery.ns), when it is
	// installed and the picture is one it shows ==> true
	ShowInGallery: func(disk)
	begin
		local gallery := GetGlobalVar('|HostGallery:host|);
		local base := GetRoot().|Gallery:host|;
		if not gallery or not base or not HostFeatureOn('gallery) then return nil;
		local soup := GetUnionSoup(soupName);
		if not soup then return nil;
		local cursor := soup:Query({});
		local e := cursor:Entry();
		while e do begin
			if IsString(e.disk) and StrEqual(e.disk, disk) and gallery:IsPicture(e) then begin
				base:ShowEntry(e);
				return true;
			end;
			e := cursor:Next();
		end;
		nil;
	end,

	// the soup is kept while Files or the Gallery (a view of it) is on
	Wanted: func() HostFeatureOn('files) or HostFeatureOn('gallery),

	// the folder looked at every few seconds while it is wanted
	Watch: func(gen)
	begin
		if gen <> generation or not :Wanted() then return;
		try :Sync() onexception |evt.ex| do
			Print("files: the Files soup could not be brought into step");
		local me := self;
		AddDelayedCall(func() me:Watch(gen), nil, pollMilliseconds);
	end,

	Start: func()
	begin
		if not :Wanted() then
			return :Stop();
		if not GetRoot().(appSymbol) then
			GetRoot().(appSymbol) := BuildContext(app);
		RegFindApps(appSymbol);
		local me := self;
		RegSoupChange(soupName, appSymbol, func(soupName, appSym, changeType, changeData)
			me:SoupChanged(soupName, appSym, changeType, changeData));
		generation := generation + 1;
		signature := nil;
		local gen := generation;
		// (later: a soup made while the system is starting is refused)
		AddDelayedCall(func() me:Watch(gen), nil, 2000);
		// (the application itself only with Files on: the Gallery alone
		// keeps the soup and Find, not the icon)
		if not HostFeatureOn('files) then begin
			local e := :IconEntry();
			if e then EntryRemoveFromSoupXmit(e, nil);
			if GetRoot().(transport.appSymbol) then UnRegTransport(transport.appSymbol);
		end
		else if not :IconEntry() then begin
			local extras := GetUnionSoup(@307.name);
			if extras then
				extras:AddToDefaultStoreXmit({class: 'ROMFormEntry, text: "Files", app: appSymbol,
					icon: :MakeIcon(), labels: nil, sequence: 33, _tagList: ['_icon, '_noBackup]}, nil);
		end;
		// "Save to Files" in every application's Action button
		if HostFeatureOn('files) and not GetRoot().(transport.appSymbol) then
			RegTransport(transport.appSymbol, transport);
	end,

	Stop: func()
	begin
		// (the soup is left; the next Start brings it into step)
		generation := generation + 1;
		UnRegFindApps(appSymbol);
		if GetRoot().(transport.appSymbol) then UnRegTransport(transport.appSymbol);
		UnRegSoupChange(soupName, appSymbol);
		local e := :IconEntry();
		if e then EntryRemoveFromSoupXmit(e, nil);
		local base := GetRoot().(appSymbol);
		if base and base.viewCObject then base:Close();
	end
}
